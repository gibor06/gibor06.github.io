---
import PhotoStory from './PhotoStory.astro';
import EvidenceGallery from './EvidenceGallery.astro';
import BaseHead from '@components/common/BaseHead.astro';
import { withBase, getRelativeLocaleUrl } from '@i18n/utils';
import '@styles/premium.css';
interface Props { lang?: 'en' | 'vi' }
const { lang = 'en' } = Astro.props;
const vi = lang === 'vi';
const t = (en: string, vn: string) => vi ? vn : en;
const route = (path: string) => getRelativeLocaleUrl(lang, path);
const nav = [['work', t('Selected work', 'Dự án')], ['experience', t('Experience', 'Kinh nghiệm')], ['research', t('Research', 'Nghiên cứu')], ['about', t('About', 'Giới thiệu')]];
const skills = [
 { n:'01', title:'Frontend', text:t('Interfaces that feel as good as they work.','Giao diện chỉn chu trong từng trải nghiệm.'), tags:['React','Next.js','TypeScript','JavaScript','HTML / CSS','Bootstrap'] },
 { n:'02', title:'Backend & systems', text:t('Connecting product experiences to business logic.','Kết nối trải nghiệm sản phẩm với nghiệp vụ.'), tags:['C# / .NET','ASP.NET','Node.js','Laravel / PHP','SQL Server','MySQL'] },
 { n:'03', title:'Research & delivery', text:t('A research mindset. A practical approach.','Tư duy nghiên cứu. Giải pháp thực tiễn.'), tags:['Python','C / C++','Git / GitHub','Vercel','Render','Firebase'] }
];
const certificates = [{"title": "Google IT Support", "file": "01-Google-IT-Support-Professional-Certificate-PW41C6D5U1OB.pdf", "image": "01.png"}, {"title": "Google AI Essentials", "file": "02-Google-AI-Essentials-Specialization-1ICQMOEYC1VB.pdf", "image": "02.png"}, {"title": "Google Prompting Essentials", "file": "03-Google-Prompting-Essentials-Specialization-9RAX4R96I2I3.pdf", "image": "03.png"}, {"title": "Google Advanced Data Analytics", "file": "04-Google-Advanced-Data-Analytics-Professional-Certificate-9VAR4VT8JLRM.pdf", "image": "04.png"}, {"title": "Google Data Analytics", "file": "05-Google-Data-Analytics-Professional-Certificate-84F7RSSP0PY1.pdf", "image": "05.png"}, {"title": "Google Business Intelligence", "file": "06-Google-Business-Intelligence-Professional-Certificate-6IK78EMEJHXL.pdf", "image": "06.png"}, {"title": "Google UX Design", "file": "07-Google-UX-Design-Professional-Certificate-ADDY4STVO74A.pdf", "image": "07.png"}, {"title": "Google Cybersecurity", "file": "08-Google-Cybersecurity-Professional-Certificate-HB7ZX6DJR656.pdf", "image": "08.png"}, {"title": "Google Project Management", "file": "09-Google-Project-Management-Professional-Certificate-CMV2EN0PYH48.pdf", "image": "09.png"}, {"title": "Google AI Professional", "file": "10-Google-AI-Professional-Certificate-6K999EVPU1V0.pdf", "image": "10.png"}];
---
<!doctype html>
<html lang={lang}>
<head><BaseHead title="Trần Gia Bảo — Full Stack Developer & Researcher" description={t('Full Stack Developer based in Ho Chi Minh City. Real-world development at Uptech, selected products and research at FAIR XIX 2026.','Portfolio Trần Gia Bảo: Full Stack Developer, kinh nghiệm Uptech, dự án thực tế và nghiên cứu FAIR XIX 2026.')} lang={lang} /><meta name="theme-color" content="#090d16" /></head>
<body class="premium">
<a href="#main" class="skip-link">{t('Skip to content','Đến nội dung chính')}</a>
<header class="site-header"><a class="wordmark" href={route('/')} aria-label="Gibor home">gibor06<span>®</span><small>TRẦN GIA BẢO</small></a><nav class="desktop-nav" aria-label={t('Main navigation','Điều hướng chính')}>{nav.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</nav><div class="header-actions"><a class="locale" href={getRelativeLocaleUrl(vi ? 'en' : 'vi','/')} lang={vi ? 'en' : 'vi'}>{vi ? 'EN' : 'VI'} </a><a class="header-contact" href="#contact">{t('Let’s talk','Liên hệ')} </a><button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('Toggle navigation','Mở đóng điều hướng')}><span></span><span></span></button></div><nav id="mobile-nav" class="mobile-nav" aria-label={t('Mobile navigation','Điều hướng di động')}>{nav.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}<a href="#contact">{t('Contact','Liên hệ')} </a></nav><div class="scroll-progress" aria-hidden="true"></div></header>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title"><div class="hero-content"><div class="hero-copy hero-profile">
  <div class="profile-kicker"><span class="profile-rule"></span>{t('SOFTWARE DEVELOPMENT · APPLIED RESEARCH','PHÁT TRIỂN PHẦN MỀM · NGHIÊN CỨU ỨNG DỤNG')}</div>
  <h1 id="hero-title">Trần Gia Bảo<span class="profile-period">.</span></h1>
  <p class="profile-role">Full Stack <span>Developer</span></p>
  <p class="profile-summary">{t('I build web applications that connect thoughtful interfaces with reliable systems. Currently contributing to real-world products at Uptech while studying Information Technology at HUIT.','Mình phát triển ứng dụng web với giao diện chỉn chu và hệ thống vững chắc. Hiện là cộng tác viên Developer tại Uptech và sinh viên Công nghệ Thông tin tại HUIT.')}</p>
  <div class="profile-stack" aria-label={t('Primary technologies','Công nghệ chính')}><span>React</span><span>Next.js</span><span>TypeScript</span><span>C# / .NET</span></div>
  <div class="hero-cta"><a class="button button-lime magnetic" href="#work">{t('View selected projects','Xem dự án tiêu biểu')}</a><a class="profile-cv" href={withBase('/cv/Tran-Gia-Bao-CV.pdf')} download><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 3h7l4 4v14H6V3h1Z"/><path d="M14 3v5h5M9 12h6M9 16h6"/></svg>{t('Download résumé','Tải hồ sơ CV')}</a></div>
  <div class="profile-facts"><div><span class="fact-label">{t('CURRENTLY AT','ĐANG LÀM VIỆC TẠI')}</span><span class="fact-value">Uptech<span class="fact-dot"></span><small>Developer</small></span></div><div><span class="fact-label">{t('EDUCATION','HỌC VẤN')}</span><span class="fact-value">HUIT <span class="fact-divider">/</span><small>GPA 3.78</small></span></div></div>
</div><PhotoStory lang={lang} /></div><div class="hero-bottom"><span>BASED IN HO CHI MINH CITY, VN <span class="lime"></span></span><a href="#work" class="scroll-discover"><span class="scroll-discover-label">{t('SCROLL TO DISCOVER','CUỘN ĐỂ KHÁM PHÁ')}</span><span class="scroll-discover-arrow" aria-hidden="true"></span></a><span>FULL STACK DEVELOPMENT & RESEARCH</span></div></section>
<div class="discipline-strip" aria-label="Full Stack Development · Creative Problem Solving · Applied Research · Meaningful Products"><div class="discipline-track" aria-hidden="true">{[0,1].map(() => <div class="discipline-group"><span>FULL STACK DEVELOPMENT</span><i>✳</i><span>CREATIVE PROBLEM SOLVING</span><i>✳</i><span>APPLIED RESEARCH</span><i>✳</i><span>MEANINGFUL PRODUCTS</span><i>✳</i></div>)}</div></div>
<section id="work" class="section wrap"><div class="section-heading reveal"><div><p class="eyebrow">01 / {t('SELECTED WORK','DỰ ÁN TIÊU BIỂU')}</p><h2>{t('Built with intent.','Xây dựng có tâm.')}<br /><span class="serif muted">{t('Made to matter.','Tạo giá trị thật.')}</span></h2></div><p class="section-aside">{t('A selection of products and systems. Real problems, deliberate decisions, practical outcomes.','Những sản phẩm và hệ thống được xây dựng từ bài toán thực tế, lựa chọn kỹ thuật có chủ đích và kết quả cụ thể.')}</p></div>
<div class="project-grid"><article class="project-card reveal"><a class="project-visual wallet-visual real-project-preview" href={route('/work/uniwallet')} aria-label={t('Explore the UniWallet project','Xem dự án UniWallet')}><div class="real-browser"><div class="real-browser-bar"><span class="browser-lights"><i></i><i></i><i></i></span><span>uniwallet.site</span><span class="browser-secure">HTTPS</span></div><img src={withBase('/assets/img/projects/uniwallet-home.png')} alt={t('Actual UniWallet homepage showing its multi-wallet platform and partner ecosystem','Giao diện trang chủ UniWallet: nền tảng quản lý đa ví điện tử và hệ sinh thái đối tác')} loading="lazy" width="1522" height="907" /></div></a><div class="project-meta"><span>01 / FINTECH · FULL STACK</span><span>LARAVEL / MYSQL</span></div><a class="project-title" href={route('/work/uniwallet')}><h3 style="view-transition-name: uniwallet-title">UniWallet</h3></a><p>{t('One platform. Multiple wallets. Top-up, transfer and payment flows connecting MoMo, ZaloPay and VNPay.','Một nền tảng, nhiều ví điện tử. Nạp tiền, chuyển tiền và thanh toán kết nối MoMo, ZaloPay và VNPay.')}</p></article>
<article class="project-card reveal"><a class="project-visual market-visual real-project-preview markai-preview" href={route('/work/markai')} aria-label={t('Explore the MarkAI project','Xem dự án MarkAI')}><div class="real-browser"><div class="real-browser-bar"><span class="browser-lights"><i></i><i></i><i></i></span><span>marketai.site</span><span class="browser-secure">HTTPS</span></div><img src={withBase('/assets/img/projects/markai-home.png')} alt={t('Actual MarkAI homepage for its retail management platform','Giao diện thực tế trang chủ MarkAI, nền tảng quản lý cửa hàng')} loading="lazy" width="1573" height="738" /></div></a><div class="project-meta"><span>02 / AGENTIC AI · RETAIL PLATFORM</span><span>JELLY / POS / INVENTORY</span></div><a class="project-title" href={route('/work/markai')}><h3 style="view-transition-name: markai-title">MarkAI</h3></a><p>{t('Retail management with Agentic Jelly: connect sales, inventory and revenue with AI-assisted insights and next-step recommendations.','Quản lý bán lẻ cùng Agentic Jelly: kết nối bán hàng, tồn kho và doanh thu với trợ lý AI hỗ trợ phân tích, gợi ý bước xử lý tiếp theo.')}</p></article>
<article class="project-card project-wide coffee-direct-card reveal"><a class="coffee-direct-preview" href="https://giborcoffee.vercel.app/" target="_blank" rel="noreferrer" aria-label={t('Visit GIBOR Coffee website','Truy cập website GIBOR Coffee')}><div class="coffee-preview-top"><span class="eyebrow">03 / E-COMMERCE WEBSITE</span><span class="coffee-preview-live"><i></i> LIVE WEBSITE</span></div><div class="coffee-browser"><div class="coffee-browser-bar"><span class="browser-lights"><i></i><i></i><i></i></span><span>giborcoffee.vercel.app</span><span class="coffee-browser-caption">GIBOR COFFEE</span></div><img src={withBase('/assets/img/projects/gibor-coffee-storefront.png')} alt={t('GIBOR Coffee storefront with coffee menu and online ordering','Giao diện website GIBOR Coffee với thực đơn và đặt hàng trực tuyến')} loading="lazy" width="1440" height="900" /></div><span class="coffee-preview-cta">{t('Visit website','Truy cập website')}</span></a><div class="project-meta"><span>FRONTEND · E-COMMERCE</span><span>HTML / CSS / JAVASCRIPT / FIREBASE</span></div><div class="project-title"><a href="https://giborcoffee.vercel.app/" target="_blank" rel="noreferrer"><h3>GIBOR Coffee</h3></a></div><p>{t('A responsive coffee storefront with a product menu, branch finder and shopping cart. As Frontend Lead, I built the Home, About, Contact and Branches pages, plus shared navigation and theme logic.','Website đặt cà phê với thực đơn, tra cứu chi nhánh và giỏ hàng. Với vai trò Frontend Lead, mình xây dựng các trang Trang chủ, Giới thiệu, Liên hệ, Chi nhánh và logic điều hướng, giao diện dùng chung.')}</p></article></div><a class="all-work text-link" href="https://github.com/gibor06" target="_blank" rel="noreferrer">{t('Explore the project archive','Khám phá kho dự án')} </a></section>
<section id="experience" class="experience-section"><div class="wrap section"><div class="section-heading reveal"><div><p class="eyebrow">02 / {t('IN THE REAL WORLD','KINH NGHIỆM THỰC TẾ')}</p><h2 class="experience-title">{t('Experience at Uptech.','Kinh nghiệm tại Uptech.')}</h2></div><span class="experience-date">08.2026 — {t('PRESENT','HIỆN TẠI')}</span></div><div class="experience-layout"><div class="company-info company-simple reveal"><h3 class="uptech-brand"><img src={withBase('/assets/img/uptech-logo.png')} alt="Uptech" width="306" height="69" loading="lazy" /><img class="uptech-light-wordmark" src={withBase('/assets/img/uptech-logo.png')} alt="" aria-hidden="true" width="306" height="69" loading="lazy" /><img class="uptech-light-symbol" src={withBase('/assets/img/uptech-logo.png')} alt="" aria-hidden="true" width="306" height="69" loading="lazy" /></h3><p class="company-legal">Technology Solutions Co., Ltd</p><span class="role-pill">{t('Developer Collaborator','Cộng tác viên Developer')}</span><p class="company-summary">{t('Developing CRM systems, client websites and application deployments.','Phát triển CRM, website cho khách hàng và triển khai ứng dụng.')}</p><div class="company-plain-projects"><span>{t('Projects','Dự án')}</span><a href="#uptech-crm">CRM Uptech</a><a href="https://hdbs.vn/ipo/" target="_blank" rel="noreferrer">HDBS</a><a href="https://firebeat.uptech.vn/" target="_blank" rel="noreferrer">Firebeat</a></div></div><div class="experience-stories"><article id="uptech-crm" class="experience-story crm-experience reveal"><div class="crm-card-heading"><div><span class="crm-project-index">01 / {t('BUSINESS SOFTWARE','PHẦN MỀM DOANH NGHIỆP')}</span><h3>CRM Uptech</h3></div><span class="crm-product-tag">UPTECH OS</span></div><a class="crm-preview" href={withBase('/assets/img/projects/uptech-crm.png')} target="_blank" rel="noreferrer" aria-label={t('View Uptech OS interface','Xem giao diện Uptech OS')}><div class="crm-preview-bar"><span class="browser-lights"><i></i><i></i><i></i></span><span>UPTECH OS / CRM</span><span class="crm-preview-type">WEB APP</span></div><img src={withBase('/assets/img/projects/uptech-crm.png')} alt={t('Uptech OS login interface introducing its CRM, project, HR and finance workspace','Giao diện Uptech OS với giới thiệu hệ thống CRM, dự án, nhân sự và tài chính')} width="1917" height="782" loading="lazy" /></a><p class="crm-card-summary">{t('Developing and improving Uptech CRM across Sales, customer services, quotations, finance and HR. Integrating MISA eSign and strengthening access control, testing and deployment workflows.','Tham gia phát triển và cải tiến CRM Uptech: Sales, khách hàng, báo giá, tài chính và nhân sự. Tích hợp MISA eSign, hoàn thiện phân quyền, kiểm thử và quy trình triển khai.')}</p><div class="crm-results crm-contributions"><div class="crm-result"><span>01 / SALES</span><h4>{t('Lead workflows','Quy trình Lead')}</h4><p>{t('Improved lead assignment, follow-up reminders and event-driven lead lifecycles.','Cải tiến phân công Lead, nhắc chăm sóc khách hàng và vòng đời Lead theo sự kiện.')}</p></div><div class="crm-result"><span>02 / {t('DOCUMENTS','CHỨNG TỪ')}</span><h4>{t('Quotations & e-signing','Báo giá & ký số')}</h4><p>{t('Improved PDF/Word exports and integrated MISA eSign for online quotation signing.','Hoàn thiện xuất PDF/Word và tích hợp MISA eSign ký báo giá trực tuyến.')}</p></div><div class="crm-result"><span>03 / {t('SECURITY','BẢO MẬT')}</span><h4>{t('Data access control','Phân quyền dữ liệu')}</h4><p>{t('Improved data ownership checks, role-based access and session security.','Hoàn thiện phạm vi dữ liệu, phân quyền theo vai trò và bảo mật phiên đăng nhập.')}</p></div></div><div class="crm-scope-tags"><span>Lead & Sales</span><span>{t('Customer services','Khách hàng & dịch vụ')}</span><span>{t('Quotations & MISA eSign','Báo giá & MISA eSign')}</span><span>{t('Finance & HR','Tài chính & nhân sự')}</span><span>RBAC · CI/CD</span></div></article><article id="uptech-hdbs" class="experience-story hdbs-experience reveal"><div class="hdbs-card-heading"><div><span class="crm-project-index">02 / {t('CLIENT PROJECT','DỰ ÁN KHÁCH HÀNG')}</span><h3>HDBS <span class="muted">/ IPO Landing Page</span></h3></div><span class="hdbs-brand-tag">HD Securities</span></div><a class="hdbs-preview" href="https://hdbs.vn/ipo/" target="_blank" rel="noreferrer" aria-label={t('Visit HDBS IPO website','Truy cập website IPO HDBS')}><img src={withBase('/assets/img/projects/hdbs-ipo.png')} alt={t('HD Securities IPO website interface','Giao diện website IPO Chứng khoán HD')} width="1896" height="903" loading="lazy" /><span>{t('Visit website','Truy cập website')} </span></a><p class="hdbs-summary">{t('Built the IPO landing page from Figma and refined it with client feedback. Supported server configuration and website maintenance.','Xây dựng landing page IPO theo thiết kế Figma, hoàn thiện theo phản hồi khách hàng. Hỗ trợ cấu hình máy chủ và bảo trì website.')}</p><div class="crm-results crm-contributions hdbs-contributions"><div class="crm-result"><span>01 / {t('INTERFACE','GIAO DIỆN')}</span><h4>{t('Figma to web','Figma  Web')}</h4><p>{t('Built the IPO landing page to match the provided design.','Triển khai landing page IPO theo thiết kế Figma.')}</p></div><div class="crm-result"><span>02 / {t('REFINEMENT','HOÀN THIỆN')}</span><h4>{t('Client feedback','Phản hồi & cải tiến')}</h4><p>{t('Refined the interface and content based on client feedback.','Điều chỉnh giao diện và nội dung theo phản hồi khách hàng.')}</p></div><div class="crm-result"><span>03 / {t('OPERATIONS','VẬN HÀNH')}</span><h4>{t('Server & maintenance','Máy chủ & bảo trì')}</h4><p>{t('Configured IIS ARR, upgraded WordPress/PHP and resolved HTTP 500 errors.','Cấu hình IIS ARR, nâng cấp WordPress/PHP và xử lý lỗi HTTP 500.')}</p></div></div><div class="crm-scope-tags"><span>Figma  Web</span><span>WordPress · PHP</span><span>IIS · Windows Server</span></div></article><article id="uptech-firebeat" class="experience-story hdbs-experience firebeat-experience reveal"><div class="hdbs-card-heading"><div><span class="crm-project-index">03 / {t('CLIENT PROJECT','DỰ ÁN KHÁCH HÀNG')}</span><h3>Firebeat <span class="muted">/ World Festival</span></h3></div><span class="hdbs-brand-tag">FESTIVAL WEBSITE</span></div><a class="hdbs-preview" href="https://firebeat.uptech.vn/" target="_blank" rel="noreferrer" aria-label={t('Visit Firebeat website','Truy cập website Firebeat')}><img src={withBase('/assets/img/projects/firebeat-home.png')} alt="Hanoi Firebeat World Festival 2026" width="1901" height="908" loading="lazy" /><span>{t('Visit website','Truy cập website')} </span></a><p class="hdbs-summary">{t('Contributed across the festival website: responsive bilingual interfaces, CMS workflows, security, offline guides and production improvements.','Tham gia phát triển website lễ hội từ giao diện đa ngôn ngữ đến CMS, bảo mật, hướng dẫn offline và tối ưu vận hành.')}</p><div class="crm-results crm-contributions hdbs-contributions"><div class="crm-result"><span>01 / {t('EXPERIENCE','TRẢI NGHIỆM')}</span><h4>{t('Festival interfaces','Giao diện lễ hội')}</h4><p>{t('Refined sponsor and booth pages, home content and interactive maps; synchronized Vietnamese–English layouts across devices.','Hoàn thiện trang gian hàng, tài trợ, trang chủ và bản đồ; đồng bộ giao diện Việt–Anh trên nhiều thiết bị.')}</p></div><div class="crm-result"><span>02 / CMS & {t('SECURITY','BẢO MẬT')}</span><h4>{t('Content & access','Nội dung & phân quyền')}</h4><p>{t('Added content approval and publishing permissions, connected schedules and contests to CMS, and strengthened IP and session controls.','Bổ sung duyệt nội dung, phân quyền xuất bản và kết nối lịch trình, cuộc thi với CMS; siết kiểm soát IP và phiên đăng nhập.')}</p></div><div class="crm-result"><span>03 / {t('OPERATIONS','VẬN HÀNH')}</span><h4>{t('Offline & performance','Offline & hiệu năng')}</h4><p>{t('Built auto-saved offline guides; optimized media and low-end devices, and fixed CI and Docker production issues.','Xây dựng hướng dẫn offline tự lưu; tối ưu media, thiết bị yếu và xử lý lỗi CI, Docker production.')}</p></div></div><div class="crm-scope-tags"><span>Responsive · VI / EN</span><span>CMS · RBAC</span><span>Service Worker</span><span>SEO · Docker</span></div></article></div></div></div></section>
