---
import MarkAiStrengths from './MarkAiStrengths.astro';
import BaseHead from '@components/common/BaseHead.astro';
import { withBase, getRelativeLocaleUrl } from '@i18n/utils';
import '@styles/premium.css';
import '@styles/case-study.css';
import '@styles/case-sections.css';
interface Props { lang?: 'en' | 'vi'; project: 'uniwallet' | 'markai' }
const { lang = 'en', project } = Astro.props;
const vi = lang === 'vi';
const t = (en: string, vn: string) => vi ? vn : en;
const wallet = project === 'uniwallet';
const name = wallet ? 'UniWallet' : 'MarkAI';
const domain = wallet ? 'uniwallet.site' : 'marketai.site';
const image = withBase(`/assets/img/projects/${wallet ? 'uniwallet' : 'markai'}-home.png`);
const home = getRelativeLocaleUrl(lang, '/');
const nextProject = wallet ? 'markai' : 'uniwallet';
const nextImage = withBase(`/assets/img/projects/${wallet ? 'markai' : 'uniwallet'}-home.png`);
const subtitle = wallet ? t('Multiple wallets. One connected experience.', 'Kết nối đa ví trong một trải nghiệm.') : t('Agentic Jelly for smarter retail.', 'Vận hành cửa hàng cùng Agentic Jelly.');
const intro = wallet ? t('A multi-wallet aggregator bringing MoMo, ZaloPay and VNPay together with top-up, withdrawal, transfer and bill payment flows.', 'Nền tảng tổng hợp ví điện tử, kết nối MoMo, ZaloPay và VNPay với các luồng nạp tiền, rút tiền, chuyển tiền và thanh toán hóa đơn.') : t('An AI-assisted retail platform combining POS, inventory, orders and reporting with Jelly, a contextual assistant for business insights and next-step recommendations.', 'Nền tảng quản lý bán lẻ tích hợp AI, kết nối POS, tồn kho, đơn hàng và báo cáo với Jelly — trợ lý hỗ trợ đọc dữ liệu kinh doanh và gợi ý bước xử lý tiếp theo.');
const role = 'Full-Stack Developer';
const tags = wallet ? ['Laravel', 'PHP', 'Blade', 'Bootstrap 5', 'MySQL'] : ['Agentic AI', 'Jelly', 'POS', 'Inventory', 'Business reporting'];
const sectionOffset = wallet ? 0 : 1;
const features = wallet ? [
 { icon:'01', title:t('Top-up & withdrawal','Nạp & rút tiền'), description:t('Transaction flows for adding funds to and withdrawing funds from connected wallets.','Các luồng giao dịch nạp tiền vào và rút tiền từ ví được kết nối.') },
 { icon:'02', title:t('Money transfers','Chuyển tiền'), description:t('Transfer flows within the multi-wallet platform, alongside a connected view of wallet services.','Luồng chuyển tiền trong nền tảng tổng hợp, kết nối các dịch vụ ví điện tử.') },
 { icon:'03', title:t('Bill payments','Thanh toán hóa đơn'), description:t('Bill payment functionality as part of the same web experience.','Tính năng thanh toán hóa đơn được tích hợp trong cùng trải nghiệm web.') },
 { icon:'04', title:t('Wallet integrations','Tích hợp đa ví'), description:t('Connecting MoMo, ZaloPay and VNPay in one platform.','Kết nối MoMo, ZaloPay và VNPay trên một nền tảng.') },
] : [
 { icon:'01', title:t('Point of sale','Bán hàng POS'), description:t('A workspace for everyday in-store sales operations.','Không gian thao tác cho hoạt động bán hàng hằng ngày tại cửa hàng.') },
 { icon:'02', title:t('Products & inventory','Sản phẩm & tồn kho'), description:t('Product management and stock tracking within the retail platform.','Quản lý sản phẩm và theo dõi tồn kho trên nền tảng bán lẻ.') },
 { icon:'03', title:t('Order management','Quản lý đơn hàng'), description:t('Order records connected with the shop’s sales and operational workflow.','Quản lý đơn hàng gắn với hoạt động bán hàng và vận hành cửa hàng.') },
 { icon:'04', title:t('Revenue & profit','Doanh thu & lợi nhuận'), description:t('Business reporting to follow revenue and profit alongside daily operations.','Theo dõi doanh thu và lợi nhuận song song với hoạt động vận hành.') },
];
const sections = [['overview',t('Overview','Tổng quan')],...(!wallet ? [['jelly','Agentic Jelly']] : []),['features',t('Product scope','Chức năng')],['implementation',t('Implementation','Triển khai')]];
---
<!doctype html>
<html lang={lang}>
<head><BaseHead title={`${name} — Case Study · Trần Gia Bảo`} description={intro} lang={lang} /><meta name="theme-color" content="#090d16" /></head>
<body class:list={['premium','study-page',wallet ? 'study-wallet' : 'study-markai']}>
<a href="#main" class="skip-link">{t('Skip to content','Đến nội dung chính')}</a>
<header class="site-header study-header"><a class="wordmark" href={home}>gibor06<span>®</span><small>TRẦN GIA BẢO</small></a><nav aria-label={t('Project navigation','Điều hướng dự án')}><a href={`${home}#work`} class="study-back">{t('All projects','Tất cả dự án')}</a><span class="study-nav-divider"></span><span class="study-current">{name}</span></nav><div class="study-header-actions"><a class="locale" href={getRelativeLocaleUrl(vi ? 'en' : 'vi',`/work/${project}`)}>{vi ? 'EN' : 'VI'}</a><a class="study-header-visit" href={`https://${domain}`} target="_blank" rel="noreferrer">{t('Visit website','Mở website')}</a></div><div class="scroll-progress" aria-hidden="true"></div></header>
<main id="main">
<section class="study-hero study-wrap">
 <div class="study-breadcrumb"><a href={home}>Portfolio</a><span>/</span><a href={`${home}#work`}>{t('Projects','Dự án')}</a><span>/</span><span>{name}</span></div>
 <div class="study-hero-grid"><div><h1 style={`view-transition-name: ${project}-title`}>{wallet ? <><span class="uni-title-first">Uni</span><span class="uni-title-wallet">Wallet</span></> : <><span class="mark-title-first">Mark</span><span class="mark-title-ai">AI</span></>}</h1><p class="study-subtitle">{subtitle}</p><p class="study-intro">{intro}</p><div class="study-actions"><a class="button button-lime magnetic" href={`https://${domain}`} target="_blank" rel="noreferrer">{t('Explore the product','Khám phá sản phẩm')}</a><a class="study-secondary" href="#overview">{t('Read the case study','Tìm hiểu dự án')}<span aria-hidden="true"></span></a></div></div>
 <aside class="study-facts project-brief">
 <div class="brief-heading"><div><span class="brief-eyebrow">{t('PROJECT DETAILS','THÔNG TIN DỰ ÁN')}</span><h2>{t('At a glance','Tổng quan')}</h2></div><span class="brief-type">Web App</span></div>
 <div class="brief-details"><div class="brief-detail"><span>{t('My role','Vai trò')}</span><strong>{role}</strong></div><div class="brief-detail"><span>{t('Product','Sản phẩm')}</span><strong>{wallet ? t('Multi-wallet platform','Nền tảng tổng hợp đa ví') : t('Retail management','Quản lý bán lẻ')}</strong></div></div>
 <a class="brief-website" href={`https://${domain}`} target="_blank" rel="noreferrer"><span class="brief-web-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 6.5h14M5 17.5h14"/></svg></span><span><small>{t('Product website','Website sản phẩm')}</small><strong>{domain}</strong></span><span class="brief-visit">{t('Visit','Truy cập')}</span></a>
 <div class="brief-stack"><span>{wallet ? t('Tech stack','Công nghệ sử dụng') : t('Core capabilities','Chức năng chính')}</span><div class="study-tags">{tags.map(tag => <span><i aria-hidden="true"></i>{tag}</span>)}</div></div>
</aside></div>
</section>
<section class="study-wrap study-showcase"><div class="study-screen"><div class="study-screen-bar"><span class="browser-lights"><i></i><i></i><i></i></span><span class="study-address">{domain}</span><span class="study-screen-type">DESKTOP VIEW</span></div><a class="study-screen-link" href={image} target="_blank" rel="noreferrer" aria-label={t(`Open ${name} screenshot`, `Xem ảnh giao diện ${name}`)}><img src={image} alt={t(`Actual ${name} product homepage`, `Giao diện thực tế trang chủ ${name}`)} width={wallet ? 1522 : 1573} height={wallet ? 907 : 738} fetchpriority="high" /></a></div><div class="study-screen-caption"><span>01 / {t('PRODUCT HOMEPAGE','GIAO DIỆN TRANG CHỦ')}</span><span>{t('Select image to view full size','Chọn ảnh để xem kích thước đầy đủ')}</span></div></section>
<div class="study-wrap study-body"><aside class="study-toc"><span>{t('IN THIS PROJECT','NỘI DUNG DỰ ÁN')}</span><nav aria-label={t('Contents','Mục lục')}>{sections.map(([id,label],i) => <a href={`#${id}`}><span>0{i+1}</span>{label}</a>)}</nav><a class="study-toc-contact" href="mailto:gibor06.dev@gmail.com">{t('Discuss this project','Trao đổi về dự án')}</a></aside>
<div class="study-article">
<section id="overview" class="study-section reveal" data-section-number="01"><p class="study-section-index">01 / {t('OVERVIEW','TỔNG QUAN')}</p><h2>{t('The problem behind the product.','Bài toán phía sau sản phẩm.')}</h2><p class="study-lead">{wallet ? t('Different wallets, different transaction flows. The goal is to bring those financial interactions together in one web platform.','Nhiều ví điện tử đồng nghĩa với nhiều luồng giao dịch riêng biệt. Mục tiêu là tập hợp các tương tác tài chính đó vào một nền tảng web.') : t('Sales, inventory and business reporting are connected parts of running a shop. The goal is to bring them into the same operational workspace.','Bán hàng, tồn kho và báo cáo kinh doanh là các phần liên quan chặt chẽ trong vận hành cửa hàng. Mục tiêu là kết nối chúng trong cùng không gian làm việc.')}</p><div class="study-overview-cards"><article class="overview-product"><div class="overview-card-top"><span class="overview-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="4" width="18" height="15" rx="3"/><path d="M3 9h18M8 14h4M8 16h7"/></svg></span><span class="overview-card-kind">PRODUCT</span></div><span class="study-card-kicker">{t('THE PRODUCT','SẢN PHẨM')}</span><h3>{wallet ? t('Connected wallet services','Kết nối dịch vụ ví') : t('Connected shop operations','Kết nối vận hành cửa hàng')}</h3><p>{intro}</p><div class="overview-card-tags">{(wallet ? ['MoMo','ZaloPay','VNPay'] : ['POS','Inventory','Reporting']).map(tag => <span>{tag}</span>)}</div></article><article class="overview-contribution"><div class="overview-card-top"><span class="overview-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16"/></svg></span><span class="overview-card-kind">CONTRIBUTION</span></div><span class="study-card-kicker">{t('MY CONTRIBUTION','ĐÓNG GÓP CỦA MÌNH')}</span><h3>{wallet ? t('Full Stack development','Phát triển Full Stack') : t('Full Stack & AI integration','Full Stack & tích hợp AI')}</h3><p>{wallet ? t('Built the multi-wallet platform and its top-up, withdrawal, transfer and payment flows using Laravel, PHP, Blade, Bootstrap 5 and MySQL.','Xây dựng nền tảng tổng hợp đa ví và các luồng nạp tiền, rút tiền, chuyển tiền, thanh toán bằng Laravel, PHP, Blade, Bootstrap 5 và MySQL.') : t('Built web functionality for small shops covering POS sales, products, inventory, orders, revenue and profit tracking.','Xây dựng chức năng web cho cửa hàng nhỏ, bao gồm bán hàng POS, sản phẩm, tồn kho, đơn hàng, doanh thu và lợi nhuận.')}</p><div class="overview-card-tags">{(wallet ? ['Frontend','Backend','Database'] : ['Web platform','POS','Inventory']).map(tag => <span>{tag}</span>)}</div></article></div>
<div class="study-product-map"><div class="product-map-header"><span class="study-card-kicker">{t('PRODUCT AT A GLANCE','SƠ ĐỒ CHỨC NĂNG')}</span><span>{wallet ? 'MULTI-WALLET' : 'RETAIL OPERATIONS'}</span></div><div class="product-map-body"><div class="map-inputs">{(wallet ? ['MoMo','ZaloPay','VNPay'] : [t('Sales','Bán hàng'),t('Products','Sản phẩm'),t('Orders','Đơn hàng')]).map(label => <span>{label}</span>)}</div><div class="map-connector" aria-hidden="true"><i></i><span></span><i></i></div><div class="map-hub">{wallet ? <span class="map-brand-uniwallet"><img src={withBase('/assets/img/projects/uniwallet-logo.png')} alt="UniWallet — Financial Core" width="320" height="80" /><img class="map-logo-light-text" src={withBase('/assets/img/projects/uniwallet-logo.png')} alt="" aria-hidden="true" width="320" height="80" /></span> : <strong class="map-brand-markai"><span>Mark</span><span>AI</span></strong>}<span>{wallet ? t('Connected wallets','Kết nối đa ví') : t('Connected operations','Kết nối vận hành')}</span></div><div class="map-connector" aria-hidden="true"><i></i><span></span><i></i></div><div class="map-outputs">{(wallet ? [t('Top-up','Nạp tiền'),t('Withdraw','Rút tiền'),t('Transfer','Chuyển tiền'),t('Pay bills','Hóa đơn')] : [t('Inventory','Tồn kho'),t('Revenue','Doanh thu'),t('Profit','Lợi nhuận')]).map(label => <span><i></i>{label}</span>)}</div></div></div>
</section>
{!wallet && <MarkAiStrengths lang={lang} />}
<section id="features" class="study-section reveal" data-section-number={String(2 + sectionOffset).padStart(2,'0')}><p class="study-section-index">{String(2 + sectionOffset).padStart(2,'0')} / {t('PRODUCT SCOPE','PHẠM VI CHỨC NĂNG')}</p><h2>{t('Built around everyday needs.','Tập trung vào nhu cầu thực tế.')}</h2><p class="study-lead">{wallet ? t('Four connected capabilities define the scope of the multi-wallet experience.','Bốn nhóm chức năng tạo nên trải nghiệm tổng hợp đa ví.') : t('Four connected areas cover the core operations of a small retail shop.','Bốn nhóm chức năng kết nối các hoạt động chính của cửa hàng bán lẻ nhỏ.')}</p><div class="study-feature-grid">{features.map(feature => <article><span>{feature.icon}</span><h3>{feature.title}</h3><p>{feature.description}</p></article>)}</div></section>
<section id="implementation" class="study-section reveal" data-section-number={String(3 + sectionOffset).padStart(2,'0')}><p class="study-section-index">{String(3 + sectionOffset).padStart(2,'0')} / {t('IMPLEMENTATION','TRIỂN KHAI')}</p><h2>{wallet ? t('From interface to data.','Từ giao diện đến dữ liệu.') : t('One workspace for shop operations.','Một không gian cho việc vận hành.')}</h2><p class="study-lead">{wallet ? t('The stack connects server-rendered views, application logic and relational storage.','Bộ công nghệ kết nối giao diện hiển thị phía máy chủ, xử lý nghiệp vụ và lưu trữ dữ liệu quan hệ.') : t('The platform connects daily sales and stock management with order records and business reporting.','Nền tảng kết nối bán hàng và quản lý tồn kho hằng ngày với đơn hàng và báo cáo kinh doanh.')}</p><div class="study-stack-list">{(wallet ? [ ['01','Frontend','Blade · Bootstrap 5',t('Web interfaces and responsive presentation.','Giao diện web và trình bày thích ứng với thiết bị.')],['02','Backend','Laravel · PHP',t('Application logic and transaction flows.','Xử lý nghiệp vụ và các luồng giao dịch.')],['03','Database','MySQL',t('Data storage for the multi-wallet application.','Lưu trữ dữ liệu cho ứng dụng tổng hợp đa ví.')] ] : [ ['01',t('Sales','Bán hàng'),'POS · Orders',t('Daily sales and order management.','Bán hàng hằng ngày và quản lý đơn hàng.')],['02',t('Operations','Vận hành'),'Products · Inventory',t('Product records and stock tracking.','Thông tin sản phẩm và theo dõi tồn kho.')],['03',t('Reporting','Báo cáo'),'Revenue · Profit',t('Revenue and profit visibility.','Theo dõi doanh thu và lợi nhuận.')] ]).map(([index,label,stack,description]) => <article><span class="study-stack-number">{index}</span><div><h3>{label}</h3><p>{description}</p></div><span class="study-stack-value">{stack}</span></article>)}</div><div class="study-discuss"><div><h3>{t('Want to go deeper?','Muốn tìm hiểu sâu hơn?')}</h3><p>{t('Let’s talk about the product, the implementation or my contribution.','Mình sẵn sàng trao đổi thêm về sản phẩm, cách triển khai và phần việc mình thực hiện.')}</p></div><a href="mailto:gibor06.dev@gmail.com">{t('Get in touch','Liên hệ mình')}</a></div></section>
</div></div>
<section class="study-wrap study-next"><a class="study-next-card" href={getRelativeLocaleUrl(lang,`/work/${nextProject}`)}><div><span class="study-section-index">{t('NEXT PROJECT','DỰ ÁN TIẾP THEO')}</span><h2>{wallet ? 'MarkAI' : 'UniWallet'}</h2><p>{wallet ? t('Retail management with Agentic Jelly.','Quản lý bán lẻ cùng Agentic Jelly.') : t('A connected platform for multiple wallets.','Nền tảng kết nối nhiều ví điện tử.')}</p><span class="study-next-label">{t('Explore case study','Xem chi tiết dự án')}</span></div><div class="study-next-image"><img src={nextImage} alt={wallet ? 'MarkAI' : 'UniWallet'} loading="lazy" width="900" height="520" /></div></a></section>
</main><footer class="site-footer study-wrap"><a class="wordmark" href={home}>gibor06<span>®</span></a><span>© {new Date().getFullYear()} TRẦN GIA BẢO</span><a href={withBase('/cv/Tran-Gia-Bao-CV.pdf')} download>CV </a></footer><script src="../../scripts/premium.ts"></script><script src="../../scripts/case-contents.ts"></script>
</body></html>
